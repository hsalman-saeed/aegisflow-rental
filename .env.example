# -----------------------------------------------------------------------------
# AegisFlow Rental - Environment Configuration Template
# (Server-only secrets. Never commit .env.local to version control)
# -----------------------------------------------------------------------------

# PayPal Braintree Sandbox Credentials (Official Rules Sec. 4)
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=your_merchant_id_here
BRAINTREE_PUBLIC_KEY=your_public_key_here
BRAINTREE_PRIVATE_KEY=your_private_key_here

# AWS Bedrock Credentials ($350 AWS Credit - Amazon Nova Pro & Lite)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Channel3 Product Catalog API (20,000 Free Credits - PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=your_channel3_key_here

# Optional: Upstash Serverless Redis (Falls back to local file store if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

